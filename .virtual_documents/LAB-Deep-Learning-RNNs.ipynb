from tensorflow.keras.callbacks import EarlyStopping
from scikeras.wrappers import KerasRegressor
from sklearn.model_selection import RandomizedSearchCV
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import SimpleRNN, Dense
from tensorflow.keras.optimizers import Adam
import tensorflow as tf
import numpy as np
import os
import tensorflow as tf

# Cambiar el nivel de registro a 2 para eliminar mensajes de información (INFO) y advertencias no importantes
os.environ['TF_CPP_MIN_LOG_LEVEL'] = '2'  # Opciones: 0 = todos, 1 = advertencias, 2 = errores, 3 = solo errores críticos

# Activar el ejecutor legacy para evitar mensajes de depuración innecesarios

# Definir el modelo LSTM
def build_lstm_model(units=30, learning_rate=0.001): 
    model = Sequential()
    model.add(SimpleRNN(units=units, activation='tanh', input_shape=(60, 1)))
    model.add(Dense(units=1))
    model.compile(optimizer=Adam(learning_rate=learning_rate), loss='mean_squared_error')
    return model

# Crear el KerasRegressor
lstm_model = KerasRegressor(model=build_lstm_model, verbose=1)

# Definir los parámetros del random search
param_distributions = {
    'model__units': [10, 20, 50],  
    'batch_size': [16, 32],
    'epochs': [5, 10],
    'model__learning_rate': [0.001, 0.01]
}

# Configurar el callback de EarlyStopping
early_stopping = EarlyStopping(monitor='loss', patience=3, restore_best_weights=True)

# Realizar el RandomizedSearchCV con el callback de EarlyStopping
random_search = RandomizedSearchCV(estimator=lstm_model, param_distributions=param_distributions, 
                                   n_iter=10,  # Número de combinaciones a probar
                                   scoring='neg_mean_squared_error', 
                                   cv=2, 
                                   random_state=42)

# Ajustar el modelo con los datos de entrenamiento y el callback
random_search_result = random_search.fit(X_train, y_train, callbacks=[early_stopping])

# Mostrar los mejores hiperparámetros y la pérdida en el conjunto de prueba
print("Best Hyperparameters: ", random_search_result.best_params_)
best_model = random_search_result.best_estimator_
test_loss = best_model.score(X_test, y_test)
print(f"Test Loss of the Best Model: {test_loss}")


